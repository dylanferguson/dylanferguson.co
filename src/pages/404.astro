  canonicalPath="/404.html"
  lang="en-AU"
  noindex
  htmlClass="theme-dark"
  bodyClass="min-h-dvh overflow-hidden font-mono"
  preloadFonts={[
    "/fonts/ibm-plex-mono-latin-600.woff2",
    "/fonts/ibm-plex-mono-latin-400.woff2",
  ]}
>
  <NotFoundExperience />
</BaseLayout>
