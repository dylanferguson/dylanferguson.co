---
import Layout from "../../layouts/Layout.astro";
import { listWritings } from "../../writings";

const description = "Occasional notes and longer pieces.";
const writings = await listWritings();
---

<Layout title="Writings" description={description} bodyClass="min-h-screen text-lg">
  <main class="mx-auto w-[min(100%_-_3rem,62ch)] pt-12 pb-18 max-lg:w-[min(100%_-_2rem,62ch)]">
    <header class="mb-8">
      <h1 class="text-3xl font-medium tracking-[-0.02em]">Writings</h1>
      <p class="mt-2 text-muted">{description}</p>
    </header>
    <ul class="space-y-3">
      {
        writings.map((writing) => (
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <time
              class="shrink-0 tabular-nums text-muted"
              datetime={writing.published}
            >
              {writing.published}
            </time>
            <a class="text-text" href={writing.href}>
              {writing.title}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
