---
import { writingsEnabled } from "../writings";

const path = Astro.url.pathname;
const isHome = path === "/";

/* /personal-canon/ is deliberately absent — it renders noindex. */
const navItems = [
  ...(writingsEnabled() ? [{ href: "/writings/", label: "Writing" }] : []),
  { href: "/software-canon/", label: "Software canon" },
  { href: "/resume/", label: "Résumé" },
];

function isCurrentNav(href: string) {
  return path === href || path.startsWith(href);
}

const brand =
  "shrink-0 font-medium no-underline aria-[current=page]:text-text aria-[current=page]:no-underline";
const navLink = "aria-[current=page]:text-text aria-[current=page]:no-underline";
const paletteTrigger =
  "cursor-pointer border-0 bg-transparent p-0 font-mono text-sm text-faint hover:text-text focus-visible:rounded-[1px] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-text";
---

{/* Site nav never prints. On the home page the header floats over the orb
    instead of sitting in flow.

    The type steps down twice on the way to the narrowest phones: `md` under
    `xs`, and `sm` below 21rem, which is the width where the brand and the
    nav labels stop fitting on one line. */}
<header
  class:list={[
    "flex items-baseline justify-between gap-6 text-lg text-muted max-xs:gap-3 max-xs:text-md max-[21rem]:text-sm print:hidden",
    isHome
      ? "fixed top-page-top right-page-right left-page-left z-3"
      : "mt-page-top mr-page-right ml-page-left",
  ]}
>
  {
    isHome ? (
      <h1 class="tracking-[0.01em] text-text">
        <a class={brand} href="/" aria-current="page">
          Dylan Ferguson
        </a>
      </h1>
    ) : (
      <a class={brand} href="/">Dylan Ferguson</a>
    )
  }
  <div class="flex items-baseline gap-4 max-xs:gap-3">
    <nav class="flex flex-wrap justify-end gap-4 max-xs:gap-3" aria-label="Primary">
      {
        navItems.map((item) => (
          <a
            class={navLink}
            href={item.href}
            aria-current={isCurrentNav(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class={paletteTrigger}
      data-command-palette-open
      aria-haspopup="dialog"
      aria-controls="command-palette"
      aria-label="Open command palette"
    >
      <kbd data-command-palette-hotkey>⌘K</kbd>
    </button>
  </div>
</header>
