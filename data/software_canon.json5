  entries: [
    {
      type: "link",
      title: "-2000 Lines Of Code",
      author: "Andy Hertzfeld",
      url: "https://www.folklore.org/Negative_2000_Lines_Of_Code.html",
      added: "2025-08-11T00:57:56Z",
      excerpts: [
        "A rewrite made QuickDraw simpler, nearly six times faster, and 2,000 lines smaller.",
      ],
      published: "1982-02",
    },
    {
      type: "link",
      title: "Five Rules of Programming",
      author: "Rob Pike",
      url: "https://web.archive.org/web/20260101104322/http://users.ece.utexas.edu/~adnan/pike.html",
      added: "2020-08-12T22:16:35Z",
      excerpts: [
        "Data dominates. If you’ve chosen the right data structures and organized things well, the algorithms will almost always be self-evident. Data structures, not algorithms, are central to programming.",
      ],
      published: "1989-02-21",
    },
    {
      type: "paper",
      title: "Big Ball of Mud",
      author: "Brian Foote and Joseph Yoder",
      url: "http://www.laputan.org/mud/",
      added: "2022-02-07T05:03:41Z",
      excerpts: [
